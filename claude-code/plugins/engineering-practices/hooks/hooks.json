{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/practices.py\"", "timeout": 10},
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/leave_it_smaller.py\" session-start", "timeout": 30}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/leave_it_smaller.py\" stop", "timeout": 30}
        ]
      }
    ]
  }
}
